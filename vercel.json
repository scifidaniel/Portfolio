{
  "redirects": [
    {
      "source": "/Portfolio.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Portfolio-v2.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Portfolio-v2-print.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/deploy/Portfolio-v2.dc.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/support.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
